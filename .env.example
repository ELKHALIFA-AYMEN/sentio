# Copy this file to .env to override the defaults (cp .env.example .env).
# Every variable is optional: compose.yaml falls back to the values shown here.
# These defaults are for local development only. Never commit a .env file.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=sentio
POSTGRES_PASSWORD=sentio
POSTGRES_DB=sentio
# Port on this machine. Change it if another PostgreSQL already uses 5432.
POSTGRES_PORT=5432

# --- Redpanda -----------------------------------------------------------------
# Kafka port on this machine (containers use redpanda:9092).
REDPANDA_KAFKA_PORT=19092
# Web console: http://localhost:8080
REDPANDA_CONSOLE_PORT=8080

# --- Simulator ----------------------------------------------------------------
# Average number of messages published per second (between 0 and 1000).
SIMULATOR_MESSAGES_PER_SECOND=5
# Share of conversations in French, between 0 and 1 (the rest is in English).
SIMULATOR_FRENCH_SHARE=0.5
# Integer seed for a reproducible stream. Leave empty for a different stream at each start.
SIMULATOR_SEED=
# Incident scenario simulated once after the start: network_outage or billing_error.
# Leave empty for normal traffic. `make incident SCENARIO=...` sets it for one run.
SIMULATOR_SCENARIO=
# Seconds between the simulator start and the beginning of the incident.
SIMULATOR_SCENARIO_DELAY_SECONDS=60
# How long the incident lasts, in seconds (600 = 10 minutes).
SIMULATOR_SCENARIO_DURATION_SECONDS=600
# Running the simulator outside Docker (uv run python -m sentio_simulator) uses
# KAFKA_BOOTSTRAP_SERVERS=localhost:19092 and SIMULATOR_TOPIC=conversations.raw by default.

# --- Logging (all services) ---------------------------------------------------
# DEBUG, INFO, WARNING or ERROR. DEBUG logs every published message.
LOG_LEVEL=INFO

# --- Topics (applied when topics are first created) ---------------------------
# Number of partitions per topic: the maximum number of consumers working in parallel.
TOPIC_PARTITIONS=3
# How long messages are kept, in milliseconds (86400000 = 24 hours).
TOPIC_RETENTION_MS=86400000
