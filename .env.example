# Copy this file to .env to override the defaults (cp .env.example .env).
# Every variable is optional: compose.yaml falls back to the values shown here.
# These defaults are for local development only. Never commit a .env file.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=sentio
POSTGRES_PASSWORD=sentio
POSTGRES_DB=sentio
# Port on this machine. Change it if another PostgreSQL already uses 5432.
POSTGRES_PORT=5432

# --- Redpanda -----------------------------------------------------------------
# Kafka port on this machine (containers use redpanda:9092).
REDPANDA_KAFKA_PORT=19092
# Web console: http://localhost:8080
REDPANDA_CONSOLE_PORT=8080

# --- Topics (applied when topics are first created) ---------------------------
# Number of partitions per topic: the maximum number of consumers working in parallel.
TOPIC_PARTITIONS=3
# How long messages are kept, in milliseconds (86400000 = 24 hours).
TOPIC_RETENTION_MS=86400000
